<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE VisioDocument PUBLIC "-//Microsoft//DTD VisioXML 15.0//EN" "http://schemas.microsoft.com/visio/2012/main.dtd">
<VisioDocument xmlns="http://schemas.microsoft.com/office/visio/2012/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:v="http://schemas.microsoft.com/office/visio/2012/main" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <DocumentProperties>
    <Title>CUDA Event Timing Diagram</Title>
    <Creator>Copilot</Creator>
    <Company>CUDA</Company>
  </DocumentProperties>
  <Pages>
    <Page ID="0" NameU="Page-1">
      <PageContents>
        <Shape ID="1" Type="Shape" LineStyle="0" FillStyle="0" TextStyle="0" NameU="Title">
          <Cell N="PinX" V="8.75"/>
          <Cell N="PinY" V="8.9"/>
          <Cell N="Width" V="12.2"/>
          <Cell N="Height" V="0.7"/>
          <Cell N="FillForegnd" V="#0B4FA3"/>
          <Cell N="LineColor" V="#0B4FA3"/>
          <Text>CUDA Event 与 Host/Device 时间关系</Text>
        </Shape>
        <Shape ID="2" Type="Shape" NameU="HostLabel">
          <Cell N="PinX" V="0.85"/>
          <Cell N="PinY" V="7.3"/>
          <Cell N="Width" V="1.55"/>
          <Cell N="Height" V="0.78"/>
          <Cell N="FillForegnd" V="#2B8BFF"/>
          <Text>Host 时间轴</Text>
        </Shape>
        <Shape ID="3" Type="Shape" NameU="DeviceLabel">
          <Cell N="PinX" V="0.85"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="1.55"/>
          <Cell N="Height" V="0.78"/>
          <Cell N="FillForegnd" V="#2CB673"/>
          <Text>Device 时间轴</Text>
        </Shape>
        <Shape ID="4" Type="Shape" NameU="HostBegin">
          <Cell N="PinX" V="2.5"/>
          <Cell N="PinY" V="7.3"/>
          <Cell N="Width" V="2.1"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#D9EBFF"/>
          <Text>EventRecord(begin)</Text>
        </Shape>
        <Shape ID="5" Type="Shape" NameU="Sleep">
          <Cell N="PinX" V="4.7"/>
          <Cell N="PinY" V="7.3"/>
          <Cell N="Width" V="2.0"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#F6D6E4"/>
          <Text>sleep(1s)</Text>
        </Shape>
        <Shape ID="6" Type="Shape" NameU="LaunchKernel">
          <Cell N="PinX" V="6.8"/>
          <Cell N="PinY" V="7.3"/>
          <Cell N="Width" V="2.1"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#E9E0FF"/>
          <Text>LaunchKernel</Text>
        </Shape>
        <Shape ID="7" Type="Shape" NameU="HostEnd">
          <Cell N="PinX" V="10.4"/>
          <Cell N="PinY" V="7.3"/>
          <Cell N="Width" V="2.1"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#E7E9FF"/>
          <Text>EventRecord(end)</Text>
        </Shape>
        <Shape ID="8" Type="Shape" NameU="DeviceBegin">
          <Cell N="PinX" V="2.5"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="2.0"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#D7EBFF"/>
          <Text>begin Event</Text>
        </Shape>
        <Shape ID="9" Type="Shape" NameU="HostInducedDelay">
          <Cell N="PinX" V="4.7"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="2.8"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#F5D6D6"/>
          <Text>Host-induced delay</Text>
        </Shape>
        <Shape ID="10" Type="Shape" NameU="Kernel">
          <Cell N="PinX" V="6.85"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="1.8"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#D3F0DE"/>
          <Text>Kernel</Text>
        </Shape>
        <Shape ID="11" Type="Shape" NameU="HostTransfer">
          <Cell N="PinX" V="9.05"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="2.0"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#D9D5FF"/>
          <Text>Host 传递延迟</Text>
        </Shape>
        <Shape ID="12" Type="Shape" NameU="DeviceEnd">
          <Cell N="PinX" V="10.9"/>
          <Cell N="PinY" V="5.35"/>
          <Cell N="Width" V="2.1"/>
          <Cell N="Height" V="0.8"/>
          <Cell N="FillForegnd" V="#DDEBFF"/>
          <Text>end Event</Text>
        </Shape>
        <Shape ID="13" Type="Shape" NameU="Section1">
          <Cell N="PinX" V="2.0"/>
          <Cell N="PinY" V="2.3"/>
          <Cell N="Width" V="3.2"/>
          <Cell N="Height" V="2.2"/>
          <Cell N="FillForegnd" V="#DDECFF"/>
          <Text>对应关系说明：
1 Host EventRecord(begin) ↔ Device begin Event
2 Host sleep(1s) ↔ Device Host-induced delay
3 Host LaunchKernel ↔ Device Kernel
4 Host EventRecord(end) ↔ Device end Event</Text>
        </Shape>
        <Shape ID="14" Type="Shape" NameU="Section2">
          <Cell N="PinX" V="6.0"/>
          <Cell N="PinY" V="2.3"/>
          <Cell N="Width" V="3.2"/>
          <Cell N="Height" V="2.2"/>
          <Cell N="FillForegnd" V="#EAF6FF"/>
          <Text>时间测量的不同含义
CUDA Event elapsed time
Insight Kernel Dur
LaunchKernel API Dur
Host Wall Time</Text>
        </Shape>
        <Shape ID="15" Type="Shape" NameU="Section3">
          <Cell N="PinX" V="10.0"/>
          <Cell N="PinY" V="2.3"/>
          <Cell N="Width" V="3.5"/>
          <Cell N="Height" V="2.2"/>
          <Cell N="FillForegnd" V="#E8F7E8"/>
          <Text>预期结果示例
Host Wall Time ≈ 1000ms + 1ms
CUDA Event elapsed ≈ 1000ms + 1ms
Kernel Dur ≈ 1ms
LaunchKernel Dur ≈ 10~100μs</Text>
        </Shape>
      </PageContents>
    </Page>
  </Pages>
</VisioDocument>